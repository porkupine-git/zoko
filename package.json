{
  "name": "zoko",
  "version": "4.1.0",
  "description": "High-Performance Pure Express.js Native Anime Streaming Engine & Scraper",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "backend": "node server.js --backend",
    "frontend": "node server.js --frontend",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "test": "node --check server.js && node --check scraper.js"
  },
  "keywords": [
    "anime",
    "streaming",
    "hls",
    "express",
    "scraper",
    "api"
  ],
  "author": "Zayrix",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "undici": "^6.28.1"
  }
}
